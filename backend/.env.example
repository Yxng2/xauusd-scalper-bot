# OANDA PRACTICE credentials
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_ACCOUNT_ID=PUT_YOUR_DEMO_ACCOUNT_ID_HERE
OANDA_TOKEN=PUT_YOUR_DEMO_TOKEN_HERE

# Put the exact Gold instrument returned by /instruments here.
# Common examples are XAU_USD, but broker availability/naming can differ.
OANDA_INSTRUMENT=XAU_USD

# Bot controls
BOT_ENABLED=false
RISK_PERCENT=0.25
MAX_DAILY_LOSS_PERCENT=2.0
MAX_TRADES_PER_DAY=10
MAX_SPREAD=0.80
RR=1.20
POLL_SECONDS=5
